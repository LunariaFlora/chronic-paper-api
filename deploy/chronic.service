[Unit]
Description=Chronic Disease Prediction API
After=network.target

[Service]
Type=simple
User=chronic
Group=chronic
WorkingDirectory=/opt/chronic
EnvironmentFile=/etc/chronic.env
ExecStart=/opt/chronic/.venv/bin/python -m service.server
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chronic

[Install]
WantedBy=multi-user.target
