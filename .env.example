# Numerical predictions need no API key. Configure your own token for remote use.
CHRONIC_HOST=127.0.0.1
CHRONIC_PORT=8765
CHRONIC_API_TOKEN=
CHRONIC_ALLOWED_ORIGINS=
# Optional: where records, uploads and generated reports are kept. Defaults to a data directory next to the code.
CHRONIC_STORAGE=
# Optional: set to 0 to allow the browser session cookie over plain HTTP (local development only).
CHRONIC_COOKIE_SECURE=1
# Optional: timezone used when reports are rendered.
CHRONIC_TIMEZONE=Asia/Shanghai
# Optional: torch thread count for waveform inference (empty = torch default).
PAPER_TORCH_THREADS=
# Optional, only for the existing health-advice feature.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.5
