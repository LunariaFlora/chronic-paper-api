  "components": {
    "schemas": {
      "AnalysisInput": {
        "properties": {
          "import_id": {
            "type": "string",
            "title": "Import Id",
            "description": "上传文件或JSON记录后返回的id"
          },
          "row": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Row",
            "description": "多行独立检查时选择当前用户对应行，从0开始"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "mmol/L",
                  "mg/dL"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit",
            "description": "原始血糖未写明单位时补充"
          },
          "advice_engine": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "rules",
                  "kimi"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Advice Engine",
            "description": "kimi使用Kimi生成建议；rules使用本地规则。有密钥时默认kimi"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "import_id"
        ],
        "title": "AnalysisInput"
      },
      "Body_blood_pressure_api_v2_blood_pressure_estimate_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "UTF-8 CSV/TSV，t 和六路信号；不是测量目录表"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "auscultatory",
              "oscillometric"
            ],
            "title": "Protocol"
          },
          "unavailable_groups": {
            "type": "string",
            "title": "Unavailable Groups",
            "description": "整组缺失时填写 ekg,optical,pressure,accel 中的名称，逗号分隔",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "file",
          "protocol"
        ],
        "title": "Body_blood_pressure_api_v2_blood_pressure_estimate_post"
      },
      "Body_hypertension_file_api_v2_hypertension_predict_file_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_hypertension_file_api_v2_hypertension_predict_file_post"
      },
      "Body_upload_api_v2_imports_post": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "建立用户后返回的id"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "该用户的CSV或Excel检查记录"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "file"
        ],
        "title": "Body_upload_api_v2_imports_post"
      },
      "ClassificationResult": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id"
          },
          "target": {
            "type": "string",
            "title": "Target"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "meaning": {
            "type": "string",
            "title": "Meaning"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/ClassificationRow"
            },
            "type": "array",
            "title": "Predictions"
          }
        },
        "type": "object",
        "required": [
          "model_id",
          "target",
          "threshold",
          "meaning",
          "count",
          "predictions"
        ],
        "title": "ClassificationResult"
      },
      "ClassificationRow": {
        "properties": {
          "row": {
            "type": "integer",
            "title": "Row"
          },
          "risk_label": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "title": "Risk Label"
          },
          "risk_probability": {
            "type": "number",
            "title": "Risk Probability"
          },
          "imputed_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Imputed Fields"
          }
        },
        "type": "object",
        "required": [
          "row",
          "risk_label",
          "risk_probability",
          "imputed_fields"
        ],
        "title": "ClassificationRow"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HypertensionInput": {
        "properties": {
          "records": {
            "items": {
              "$ref": "#/components/schemas/HypertensionRecord"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "HypertensionInput",
        "example": {
          "records": [
            {
              "BMI": 25,
              "BPMeds": 0,
              "age": 50,
              "cigsPerDay": 0,
              "currentSmoker": 0,
              "diaBP": 80,
              "diabetes": 0,
              "glucose": 90,
              "heartRate": 70,
              "male": 1,
              "sysBP": 130,
              "totChol": 200
            }
          ]
        }
      },
      "HypertensionRecord": {
        "properties": {
          "male": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Male"
          },
          "age": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 130.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "currentSmoker": {
            "anyOf": [
              {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Currentsmoker"
